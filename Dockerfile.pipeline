# The pipeline image: scrape -> silver -> dbt -> checks -> export; the same code the daily workflow runs.
# Build:  docker build -f Dockerfile.pipeline -t jobmarket-pipeline .
# Run:    docker run --rm -v "$PWD/data:/app/data" jobmarket-pipeline           (the daily flow)
#         docker run --rm -v "$PWD/data:/app/data" jobmarket-pipeline jobmarket parse all --missing
FROM python:3.11-slim

# `make` runs the flow's steps; uv is pinned to the version the lock file was made with.
RUN apt-get update \
    && apt-get install -y --no-install-recommends make \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv==0.13.7

WORKDIR /app
ENV UV_FROZEN=1 UV_NO_SYNC=1 UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1

# Dependencies first, so a code change does not reinstall them.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --no-install-project
COPY src ./src
RUN uv sync

COPY Makefile ./
COPY warehouse ./warehouse
COPY contracts ./contracts

# Data (bronze, DuckDB, exports) lives in a volume, never in the image.
RUN useradd --create-home --uid 1000 app \
    && mkdir -p /app/data /app/warehouse/target /app/warehouse/logs \
    && chown -R app:app /app/data /app/warehouse
USER app
VOLUME ["/app/data"]

CMD ["make", "pipeline"]
